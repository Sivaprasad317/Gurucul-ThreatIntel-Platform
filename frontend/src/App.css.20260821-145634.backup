@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap');

:root{
  font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif;
  color:#e8eef7;background:#070b12;font-synthesis:none;text-rendering:optimizeLegibility;
  --bg:#070b12;--panel:#0c131f;--panel2:#101a29;--line:#1b2a3d;--muted:#75869c;
  --text:#e8eef7;--green:#28d7a1;--cyan:#35c8ff;--purple:#a77cff;--yellow:#ffd24a;--red:#ff4d67;
}
*{box-sizing:border-box}html,body,#root{margin:0;min-width:320px;min-height:100%;background:var(--bg)}body{min-height:100vh}
button,input,select{font:inherit}button{cursor:pointer}
body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.35;background-image:linear-gradient(rgba(255,255,255,.028) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.028) 1px,transparent 1px);background-size:32px 32px;mask-image:linear-gradient(to bottom,#000,transparent 90%)}

.shell{display:grid;grid-template-columns:248px minmax(0,1fr);min-height:100vh}
.sidebar{position:sticky;top:0;height:100vh;padding:24px 15px;background:#080e17;border-right:1px solid var(--line);display:flex;flex-direction:column}
.brand{display:flex;align-items:center;gap:11px;padding:5px 10px 28px}.brand b{display:block;font-size:18px;letter-spacing:-.4px}.brand span{display:block;color:#74859b;font-size:11px;margin-top:2px;letter-spacing:1px;text-transform:uppercase}
.brand-logo{display:grid;place-items:center;width:42px;height:42px;border-radius:11px;background:linear-gradient(145deg,#28d7a1,#168f7a);color:#04110d;font-weight:900;font-size:21px;box-shadow:0 0 28px rgba(40,215,161,.16)}.brand-logo.large{width:54px;height:54px;font-size:27px;margin-bottom:25px}
.side-label{padding:18px 12px 7px;color:#506178;font:700 10px "JetBrains Mono",monospace;letter-spacing:1.6px}
.nav{display:flex;align-items:center;gap:11px;width:100%;padding:11px 12px;border:1px solid transparent;border-radius:9px;background:transparent;color:#8292a8;text-align:left;font-size:13px}.nav:hover{background:#0d1724;color:#c9d7e7}.nav.active{background:#0f241f;color:#45e2b0;border-color:#1c4b3f}
.side-spacer{flex:1}.side-health{padding:14px 11px;color:#73859b;font-size:12px}.status-dot{display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 10px rgba(40,215,161,.55);margin-right:8px}
.logout{border:1px solid var(--line);background:#0c131e;color:#9eafc3;padding:10px;border-radius:8px}

.main{min-width:0}.topbar{min-height:92px;padding:18px 36px;border-bottom:1px solid var(--line);background:rgba(7,11,18,.88);backdrop-filter:blur(12px);display:flex;align-items:center;justify-content:space-between;gap:20px;position:sticky;top:0;z-index:10}
.crumb{font:700 10px "JetBrains Mono",monospace;letter-spacing:1.5px;color:#64758b;text-transform:uppercase}.actor-select{display:flex;align-items:center;gap:9px;margin-top:6px}.actor-select select{appearance:none;border:0;outline:0;background:transparent;color:#f0f5fb;font-size:21px;font-weight:800;padding:0 22px 0 0;max-width:350px}.actor-select select option{background:#0c131f;color:#fff}.pill{display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;font:700 10px "JetBrains Mono",monospace;text-transform:uppercase;letter-spacing:.5px}.pill.active{background:#133d32;color:#35e0ac;border:1px solid #1e6c56}.pill.type{background:#2c2512;color:#ffd45b;border:1px solid #695322}
.top-actions{display:flex;align-items:center;gap:12px}.demo-badge{padding:6px 9px;border:1px solid #5d4b1a;border-radius:6px;background:#251e0c;color:#f4c94b;font:800 10px "JetBrains Mono",monospace}.user-badge{display:grid;place-items:center;width:34px;height:34px;border-radius:50%;background:#182435;color:#8fdfff;font:700 11px "JetBrains Mono",monospace}
.icon-button{display:grid;place-items:center;width:34px;height:34px;border:1px solid var(--line);border-radius:7px;background:#0b121d;color:#93a5bb}.icon-button:hover{color:#e9f4ff;border-color:#31516c}
.error-banner{margin:14px 36px 0;padding:11px 13px;border:1px solid #65333e;background:#28141a;color:#ffabb8;border-radius:8px;display:flex;justify-content:space-between;gap:10px;font-size:13px}.error-banner button{border:0;background:transparent;color:inherit}
.content{max-width:1700px;margin:auto;padding:24px 36px 70px}.actor-hero{display:flex;align-items:center;gap:17px;padding:20px 22px;border:1px solid #1c344c;border-radius:13px;background:linear-gradient(115deg,#0b1420,#0d1725 70%,#0d1c23);box-shadow:0 12px 40px rgba(0,0,0,.16)}
.actor-mark{width:46px;height:46px;display:grid;place-items:center;border-radius:11px;background:linear-gradient(145deg,#2bd7a2,#15967d);color:#06120f;flex:0 0 auto}.actor-hero-copy{flex:1;min-width:0}.hero-title-row{display:flex;align-items:center;gap:8px;flex-wrap:wrap}.hero-title-row h1{margin:0;font-size:27px;letter-spacing:-.9px}.actor-hero-copy p{margin:8px 0 10px;color:#8da0b7;line-height:1.5;font-size:12px;max-width:920px}.hero-meta{display:flex;gap:20px;flex-wrap:wrap;color:#65768c;font-size:11px}.hero-meta b{color:#b6c5d6;margin-left:5px}.hero-actions{display:flex;gap:8px;align-self:flex-start}.primary-button,.secondary-button{border-radius:7px;padding:9px 12px;font-size:12px;font-weight:700}.primary-button:disabled{opacity:.45;cursor:not-allowed}.primary-button{border:1px solid #249a7c;background:#12382f;color:#46e2b1}.primary-button.small{padding:9px 11px}.secondary-button{border:1px solid #29435a;background:#0c1724;color:#a9bad0}
.notice{margin:10px 0;padding:10px 13px;border:1px solid #51431e;background:#19170d;color:#a99a68;border-radius:7px;font-size:11px}.notice b{color:#e5c34c}

.kpi-grid{display:grid;grid-template-columns:repeat(8,minmax(0,1fr));gap:10px;margin:12px 0}.kpi{min-height:120px;padding:13px;border:1px solid var(--line);border-radius:10px;background:linear-gradient(150deg,#0c131f,#0a111b);position:relative;overflow:hidden}.kpi:after{content:"";position:absolute;left:0;top:0;bottom:0;width:2px;background:var(--accent)}.kpi.green{--accent:var(--green)}.kpi.cyan{--accent:var(--cyan)}.kpi.purple{--accent:var(--purple)}.kpi.yellow{--accent:var(--yellow)}.kpi.red{--accent:var(--red)}.kpi-icon{color:var(--accent);margin-bottom:12px}.kpi-label{color:#677a91;font:700 9px "JetBrains Mono",monospace;text-transform:uppercase;letter-spacing:1px}.kpi strong{display:block;margin-top:4px;color:#e7eef8;font:800 20px "JetBrains Mono",monospace;letter-spacing:-.7px;white-space:nowrap}.kpi span{display:block;margin-top:5px;color:#617287;font-size:9px}

.grid-two{display:grid;grid-template-columns:1.45fr 1fr;gap:12px;margin:12px 0}.panel{border:1px solid var(--line);border-radius:11px;background:#0b121d;overflow:hidden}.panel-head{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:13px 15px;border-bottom:1px solid #172536}.panel-head h2{margin:0;color:#d9e4ef;font:800 11px "JetBrains Mono",monospace;text-transform:uppercase;letter-spacing:1px}.panel-head span{display:block;margin-top:4px;color:#5f7187;font-size:9px}.panel-body{padding:14px}.text-button{border:0;background:transparent;color:#43ddb0;font-size:11px;font-weight:700}

.chart-wrap{height:225px;padding-top:2px}.chart{width:100%;height:205px;display:block}.gridline{stroke:#1b2a3b;stroke-width:1}.bar{fill:#2acb96;opacity:.78}.bar:hover{opacity:1}.chart text{fill:#5d7087;font-size:10px}.line{fill:none;stroke:#ff4d67;stroke-width:2.4}.point{fill:#0b121d;stroke:#ff4d67;stroke-width:1.8}.chart-axis{display:flex;justify-content:space-between;color:#5d7087;font:9px "JetBrains Mono",monospace;margin-top:-5px}

.rank-list{display:flex;flex-direction:column;gap:8px}.rank-row{display:grid;grid-template-columns:145px 1fr 40px;align-items:center;gap:10px;border:0;background:transparent;color:#c9d5e3;padding:2px 0;text-align:left}.rank-name{min-width:0}.rank-name span{display:block;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-size:11px}.rank-name em{font-style:normal;color:#506176;font:9px "JetBrains Mono",monospace}.rank-track{height:7px;background:#131f2e;border-radius:999px;overflow:hidden}.rank-track i{display:block;height:100%;border-radius:999px;background:linear-gradient(90deg,#159a76,#34d7a7)}.rank-row b{font:700 11px "JetBrains Mono",monospace;color:#b9c8d8;text-align:right}

.map-area{height:250px;position:relative;overflow:hidden;border-radius:8px;background:radial-gradient(circle at 50% 50%,#102334 0,#09111b 70%);border:1px solid #17273a}.world-silhouette{position:absolute;inset:18px}.continent{position:absolute;background:#162d40;opacity:.9;border:1px solid #21445a}.na{left:5%;top:18%;width:28%;height:28%;border-radius:48% 52% 42% 56%;transform:rotate(-8deg)}.sa{left:28%;top:48%;width:13%;height:38%;border-radius:45% 55% 48% 52%;transform:rotate(12deg)}.eu{left:44%;top:20%;width:17%;height:17%;border-radius:48%}.as{left:56%;top:18%;width:30%;height:30%;border-radius:35% 55% 45% 50%}.af{left:47%;top:43%;width:17%;height:39%;border-radius:46% 54% 42% 50%}.oc{left:73%;top:67%;width:17%;height:14%;border-radius:48%}
.map-dot{position:absolute;width:16px;height:16px;border:1px solid rgba(255,255,255,.65);border-radius:50%;background:#2bd6a1;padding:0;box-shadow:0 0 16px rgba(43,214,161,.28)}.map-dot span{display:block;width:100%;height:100%;border-radius:50%;background:#2bd6a1}.map-legend{position:absolute;left:12px;right:12px;bottom:9px;color:#596c82;font-size:9px;text-align:center}

.multi-chart{height:235px;position:relative;display:flex;flex-direction:column;gap:8px}.year-series{display:grid;grid-template-columns:42px 1fr;gap:10px;align-items:end;flex:1}.year-series>b{font:700 9px "JetBrains Mono",monospace;color:#6f8197}.month-bars{height:100%;display:flex;align-items:end;gap:4px}.month-col{height:100%;flex:1;display:flex;align-items:flex-end}.month-col i{display:block;width:100%;min-height:2px;border-radius:3px 3px 0 0;background:#a66f2b}.year-series:nth-child(2) .month-col i{background:#3a84b6}.year-series:nth-child(3) .month-col i{background:#b23a4d}.year-series:nth-child(4) .month-col i{background:#2aa57d}.month-labels{margin-left:52px;display:grid;grid-template-columns:repeat(12,1fr);color:#586a80;font-size:8px;text-align:center}

.matrix-scroll{overflow:auto}.matrix{border-collapse:collapse;width:100%;font-size:9px}.matrix th,.matrix td{padding:8px 7px;border-bottom:1px solid #182636;border-right:1px solid #182636;text-align:center}.matrix th{color:#708198;font:700 8px "JetBrains Mono",monospace;max-width:115px}.matrix td:first-child{text-align:left;color:#aab9c9;font-weight:600}.matrix td{color:#bcd1df}.quality-note{margin-top:12px;padding-top:10px;border-top:1px solid #182636;color:#5e7086;font-size:10px}.coverage{display:grid;grid-template-columns:120px 1fr 42px;align-items:center;gap:9px;margin-bottom:14px}.coverage b{display:block;color:#b9c8d8;font-size:11px}.coverage span{display:block;color:#5d6e84;font:8px "JetBrains Mono",monospace;margin-top:2px}.coverage-track{height:7px;background:#141f2e;border-radius:999px;overflow:hidden}.coverage-track i{display:block;height:100%;background:#2bd5a1;border-radius:999px}.coverage>strong{text-align:right;color:#8ddfca;font:700 10px "JetBrains Mono",monospace}

.victim-table{width:100%}.v-head,.v-row{display:grid;grid-template-columns:2fr 1fr 1.2fr 1fr;gap:12px;align-items:center}.v-head{padding:8px 10px;color:#52647a;font:700 8px "JetBrains Mono",monospace;text-transform:uppercase;border-bottom:1px solid #182636}.v-row{width:100%;padding:10px;border:0;border-bottom:1px solid #152434;background:transparent;color:#aebdce;text-align:left;font-size:10px}.v-row:hover{background:#0e1926}.v-row strong{color:#e0e8f0;font-size:11px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.v-row span{white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.empty{padding:28px;color:#607289;text-align:center;font-size:11px}

.page-title{display:flex;justify-content:space-between;margin-bottom:15px}.page-title h1{margin:6px 0 4px;font-size:25px;letter-spacing:-.7px}.page-title p{margin:0;color:#73869d;font-size:12px}
.register-panel{display:grid;grid-template-columns:1.5fr 1fr 1fr 1fr auto;gap:8px;align-items:center;padding:13px;margin-bottom:12px;border:1px solid var(--line);border-radius:10px;background:#0b121d}.register-panel>div b{display:block;font-size:11px}.register-panel>div span{display:block;color:#5f7187;font-size:9px;margin-top:3px}.register-panel input,.register-panel select{border:1px solid #21344a;background:#080e17;color:#cbd8e6;border-radius:7px;padding:9px;font-size:10px;outline:0}\n.actor-cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.actor-card{display:flex;align-items:center;gap:13px;padding:17px;border:1px solid var(--line);border-radius:10px;background:#0b121d;color:inherit;text-align:left;position:relative}.actor-card:hover,.actor-card.selected{border-color:#2a6c5a;background:#0d1b19}.actor-card-mark{width:40px;height:40px;display:grid;place-items:center;border-radius:9px;background:#12251f;color:#2bd5a1}.actor-card h2{margin:0;font-size:15px}.actor-card span{display:block;color:#6e8096;font-size:10px;margin-top:3px}.actor-card small{display:block;color:#9cb0c5;font-size:10px;margin-top:7px}.actor-card i{position:absolute;right:13px;top:13px;font-style:normal;color:#39dca9;font:700 8px "JetBrains Mono",monospace;text-transform:uppercase}

.filters{display:grid;grid-template-columns:1fr 220px 260px;gap:9px;margin-bottom:12px}.search{display:flex;align-items:center;gap:9px;border:1px solid var(--line);border-radius:8px;background:#0b121d;padding:0 11px;color:#6f8197}.search input{width:100%;border:0;outline:0;background:transparent;color:#dbe5ef;padding:10px 0;font-size:11px}.filters select{border:1px solid var(--line);border-radius:8px;background:#0b121d;color:#aebdd0;padding:0 10px;font-size:11px;outline:0}

.health-card{padding:8px}.health-state{display:flex;align-items:center;color:#45dcae;margin-bottom:16px}.health-state strong{text-transform:uppercase;font:800 11px "JetBrains Mono",monospace}.health-metrics{display:grid;grid-template-columns:1fr 1fr;gap:9px}.detail{padding:10px;border:1px solid #18283a;background:#0d1723;border-radius:7px}.detail span{display:block;color:#5d6e83;font:8px "JetBrains Mono",monospace;text-transform:uppercase}.detail b{display:block;margin-top:5px;color:#d4e0eb;font-size:11px;word-break:break-word}.collection-list{display:flex;flex-direction:column}.collection-list>div{display:flex;align-items:center;padding:12px 0;border-bottom:1px solid #172536}.collection-list b{font-size:11px}.collection-list em{margin-left:auto;color:#65778c;font:9px "JetBrains Mono",monospace;font-style:normal}
.rules p{padding:10px;margin:0;border-bottom:1px solid #172536;color:#75879d;font-size:11px}.rules b{color:#36d8a6;margin-right:6px}

.drawer-backdrop{position:fixed;inset:0;z-index:50;background:rgba(0,0,0,.7);display:flex;justify-content:flex-end}.drawer{width:min(600px,95vw);height:100%;overflow:auto;background:#090f18;border-left:1px solid #23374d;padding:24px;box-shadow:-30px 0 80px rgba(0,0,0,.45)}.drawer-top{display:flex;justify-content:space-between;gap:12px}.drawer h1{font-size:24px;margin:7px 0 20px}.drawer-grid{display:grid;grid-template-columns:1fr 1fr;gap:9px}.drawer-section{margin-top:18px;padding-top:17px;border-top:1px solid #172638}.drawer-section h3{font:700 10px "JetBrains Mono",monospace;text-transform:uppercase;color:#708197;letter-spacing:1px}.drawer-section p{color:#9eb0c3;line-height:1.6;font-size:11px}.drawer-section a{display:flex;align-items:center;gap:8px;color:#40dcae;font-size:11px;word-break:break-all}

.loading{position:fixed;right:20px;bottom:20px;padding:10px 13px;background:#12221f;border:1px solid #276552;border-radius:7px;color:#62dfb7;font:700 10px "JetBrains Mono",monospace;z-index:80}
.login{min-height:100vh;display:grid;place-items:center;padding:24px}.login-card{width:min(430px,100%);padding:34px;border:1px solid #20344a;border-radius:14px;background:#0b121d;box-shadow:0 30px 100px rgba(0,0,0,.4)}.login-card h1{font-size:25px;margin:8px 0}.login-card>p{color:#75879d;font-size:12px;line-height:1.5}.login-card label{display:block;color:#8192a7;font-size:11px;margin-top:16px}.login-card input{display:block;width:100%;margin-top:6px;border:1px solid #21344a;background:#080e17;color:#dfe8f1;border-radius:7px;padding:11px;outline:0}.login-card input:focus{border-color:#2c7a67}.login-card .primary-button{width:100%;margin-top:18px;padding:11px}.login-card small{display:block;color:#53667d;font-size:9px;margin-top:12px}.error-inline{margin-top:12px;padding:9px;border:1px solid #61323d;background:#26151b;color:#ff9eae;border-radius:6px;font-size:10px}

@media(max-width:1350px){.kpi-grid{grid-template-columns:repeat(4,1fr)}.actor-hero{align-items:flex-start}.hero-actions{flex-direction:column}.actor-cards{grid-template-columns:1fr 1fr}}
@media(max-width:1050px){.shell{grid-template-columns:76px 1fr}.sidebar{padding:20px 10px}.brand{justify-content:center}.brand>div:last-child,.side-label,.nav{font-size:0}.nav{justify-content:center;padding:12px}.nav svg{width:18px;height:18px}.side-health{font-size:0;text-align:center}.logout{font-size:0}.grid-two{grid-template-columns:1fr}.topbar,.content{padding-left:24px;padding-right:24px}}
@media(max-width:720px){.register-panel{grid-template-columns:1fr}.register-panel>div{margin-bottom:3px}.shell{display:block}.sidebar{position:static;height:auto;display:flex;flex-direction:row;align-items:center;overflow:auto;padding:10px}.brand{padding:0}.sidebar .nav{display:none}.side-spacer,.side-label,.side-health{display:none}.logout{margin-left:auto;font-size:11px}.topbar{position:static;padding:14px 16px}.actor-select select{font-size:18px;max-width:210px}.content{padding:15px}.actor-hero{flex-direction:column}.hero-actions{width:100%;flex-direction:row}.kpi-grid{grid-template-columns:repeat(2,1fr)}.grid-two{grid-template-columns:1fr}.filters{grid-template-columns:1fr}.actor-cards{grid-template-columns:1fr}.v-head{display:none}.v-row{grid-template-columns:1fr 1fr;padding:12px 8px}.v-row strong{grid-column:1/-1}.drawer-grid{grid-template-columns:1fr}.map-area{height:220px}}

/* Manual threat-actor profile editor */
.actor-profile-editor {
  margin-top: 18px;
}

.profile-form {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.profile-form label {
  display: flex;
  flex-direction: column;
  gap: 8px;
  color: #9fb0c8;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .04em;
}

.profile-form input,
.profile-form textarea {
  width: 100%;
  box-sizing: border-box;
  border: 1px solid #24364b;
  border-radius: 8px;
  background: #07101b;
  color: #e7eef8;
  padding: 11px 12px;
  font: inherit;
  font-size: 14px;
  outline: none;
}

.profile-form textarea {
  resize: vertical;
  min-height: 100px;
}

.profile-form input:focus,
.profile-form textarea:focus {
  border-color: #19c99b;
  box-shadow: 0 0 0 2px rgba(25, 201, 155, .12);
}

.profile-form-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 16px;
}

.profile-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  margin-top: 4px;
}

.profile-actions span {
  color: #60748e;
  font-size: 12px;
}

@media (max-width: 760px) {
  .profile-form-grid {
    grid-template-columns: 1fr;
  }

  .profile-actions {
    align-items: flex-start;
    flex-direction: column;
  }
}

/* =========================================================
   GURUCUl BRAND THEME
   ========================================================= */

:root {
  --gurucul-purple: #5a008f;
  --gurucul-purple-dark: #32004f;
  --gurucul-purple-deep: #210035;
  --gurucul-purple-light: #9b4dcc;
  --gurucul-magenta: #c05cff;

  --dashboard-bg: #07030d;
  --dashboard-panel: #0d0816;
  --dashboard-panel-2: #120a1d;

  --dashboard-border: #2b1740;
  --dashboard-border-light: #40205c;

  --dashboard-text: #f5edfa;
  --dashboard-muted: #9d8aaa;

  --dashboard-blue: #36c5ff;

  --status-green: #20c997;
  --status-yellow: #f5b942;
  --status-red: #ff5263;
}


/* =========================================================
   GLOBAL
   ========================================================= */

html,
body,
#root {
  min-height: 100%;
}

body {
  background:
    radial-gradient(
      circle at 50% -20%,
      rgba(90, 0, 143, 0.22),
      transparent 45%
    ),
    linear-gradient(
      180deg,
      #08030e 0%,
      #050308 100%
    );

  color: var(--dashboard-text);
}


/* =========================================================
   SIDEBAR
   ========================================================= */

.sidebar {
  background:
    linear-gradient(
      180deg,
      #09040f 0%,
      #07030c 100%
    ) !important;

  border-right: 1px solid var(--dashboard-border) !important;
}


/* =========================================================
   GURUCUl LOGO
   ========================================================= */

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
}

.brand-logo {
  width: 145px;
  height: auto;
  display: block;
  object-fit: contain;
}

.brand-text {
  display: none;
}

.brand-name {
  color: #ffffff !important;
}

.brand-subtitle {
  color: #9b4dcc !important;
}


/* =========================================================
   NAVIGATION
   ========================================================= */

.nav-item {
  color: #a994b8 !important;
}

.nav-item:hover {
  background: rgba(90, 0, 143, 0.18) !important;
  color: #ffffff !important;
}

.nav-item.active,
.nav-item[aria-current="page"] {
  background:
    linear-gradient(
      90deg,
      rgba(90, 0, 143, 0.35),
      rgba(90, 0, 143, 0.12)
    ) !important;

  border-color: rgba(155, 77, 204, 0.45) !important;
  color: #d99aff !important;
}


/* =========================================================
   MAIN AREA
   ========================================================= */

.main,
.main-content,
.content {
  background: transparent !important;
}


/* =========================================================
   TOP HEADER
   ========================================================= */

.topbar,
.header,
.page-header {
  background: rgba(7, 3, 13, 0.94) !important;
  border-bottom: 1px solid var(--dashboard-border) !important;
}


/* =========================================================
   PANELS / CARDS
   ========================================================= */

.panel,
.card,
.stat-card,
.dashboard-card {
  background:
    linear-gradient(
      145deg,
      rgba(18, 10, 29, 0.96),
      rgba(9, 5, 16, 0.96)
    ) !important;

  border-color: var(--dashboard-border) !important;
}

.panel:hover,
.card:hover,
.stat-card:hover {
  border-color: rgba(155, 77, 204, 0.55) !important;
}


/* =========================================================
   ACTOR PROFILE
   ========================================================= */

.actor-header,
.actor-profile,
.profile-header {
  background:
    linear-gradient(
      135deg,
      rgba(48, 0, 75, 0.65),
      rgba(10, 6, 18, 0.95)
    ) !important;

  border-color: var(--dashboard-border-light) !important;
}


/* =========================================================
   PRIMARY ACCENT
   ========================================================= */

.primary,
.primary-button,
.btn-primary {
  background:
    linear-gradient(
      135deg,
      #5a008f,
      #7d19b5
    ) !important;

  border-color: #8f38c5 !important;
  color: #ffffff !important;
}

.primary:hover,
.primary-button:hover,
.btn-primary:hover {
  background:
    linear-gradient(
      135deg,
      #7010aa,
      #9b2bd0
    ) !important;
}


/* =========================================================
   ACTIVE / STATUS
   ========================================================= */

.badge.active,
.status-active {
  background: rgba(32, 201, 151, 0.12) !important;
  border-color: rgba(32, 201, 151, 0.45) !important;
  color: #43e0b0 !important;
}

.badge.ransomware,
.status-ransomware {
  background: rgba(245, 185, 66, 0.10) !important;
  border-color: rgba(245, 185, 66, 0.40) !important;
  color: #f5c85e !important;
}


/* =========================================================
   PURPLE ICON ACCENTS
   ========================================================= */

.stat-card svg,
.card svg {
  color: #b85de8;
}


/* =========================================================
   CHART
   ========================================================= */

.chart-bar,
.bar {
  background:
    linear-gradient(
      180deg,
      #b04ee2,
      #650a99
    ) !important;

  box-shadow:
    0 0 12px rgba(155, 77, 204, 0.25);
}


/* =========================================================
   COUNTRY / DATA BARS
   ========================================================= */

.progress-bar,
.country-bar,
.meter-fill {
  background:
    linear-gradient(
      90deg,
      #5a008f,
      #b04ee2
    ) !important;
}


/* =========================================================
   LINKS
   ========================================================= */

a {
  color: #c77bea;
}

a:hover {
  color: #e0a9ff;
}


/* =========================================================
   BUTTONS
   ========================================================= */

button {
  border-color: var(--dashboard-border-light);
}

button:hover {
  border-color: #9b4dcc;
}


/* =========================================================
   INPUTS
   ========================================================= */

input,
select,
textarea {
  background: #0a0610 !important;
  border-color: var(--dashboard-border) !important;
  color: #ffffff !important;
}

input:focus,
select:focus,
textarea:focus {
  border-color: #8f38c5 !important;
  box-shadow: 0 0 0 2px rgba(155, 77, 204, 0.12) !important;
}


/* =========================================================
   SCROLLBAR
   ========================================================= */

::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: #08040d;
}

::-webkit-scrollbar-thumb {
  background: #35154b;
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: #6d1596;
}
